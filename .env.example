# NocoDB + Traefik + Let's Encrypt: environment variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored: never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, see the image variables at the end of this file.

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.nocodb.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED: do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# Timeouts on Traefik's HTTPS entry point. Unset, Traefik's own defaults
# apply (shown here). Raise the read timeout for large CSV imports and
# attachments on slow links; 0s means no timeout at all.
# TRAEFIK_READ_TIMEOUT=60s
# TRAEFIK_WRITE_TIMEOUT=0s
# TRAEFIK_IDLE_TIMEOUT=180s

# ──────────────────────────────────────────────────────────────────────────────
# NocoDB
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. It must resolve to this server's public IP for the Let's
# Encrypt TLS-ALPN challenge. REQUIRED.
NOCODB_HOSTNAME=nocodb.example.com

# The super admin, created on the first start and set again from here on
# every start, so this is where its email and password change. Without them
# NocoDB makes super admin of whoever signs up first. REQUIRED.
# NocoDB wants 8 or more characters with an upper-case letter, a digit and a
# special character; this makes one:
#     printf 'Nc-%s-9\n' "$(openssl rand -hex 16)"
NOCODB_ADMIN_EMAIL=admin@example.com
NOCODB_ADMIN_PASSWORD=change_me_before_first_start

# The database password. It goes into a connection URL, so it is hex.
# REQUIRED, generate with:
#     openssl rand -hex 24
NOCODB_DB_PASSWORD=change_me_before_first_start

# Signs every session. From here it is in no database backup. REQUIRED,
# generate with:
#     openssl rand -hex 32
NOCODB_JWT_SECRET=change_me_before_first_start

# Encrypts the passwords of the databases you connect NocoDB to. Keep it with
# this file, not with the backups: a restore needs the same key to open those
# connections. REQUIRED, generate with:
#     openssl rand -hex 32
NOCODB_CONNECTION_ENCRYPT_KEY=change_me_before_first_start

# Connections to databases on private addresses (your LAN, this host's Docker
# networks) are refused. true allows them, for every user who may add a data
# source. Default: false.
# NOCODB_ALLOW_LOCAL_EXTERNAL_DBS=false

# Defaults below are set in the compose file; override only to diverge.
# NOCODB_DB_NAME=nocodbdb
# NOCODB_DB_USER=nocodbdbuser

# ──────────────────────────────────────────────────────────────────────────────
# Redis (optional: off unless both lines are set)
# ──────────────────────────────────────────────────────────────────────────────

# COMPOSE_PROFILES=redis
# NOCODB_REDIS_URL=redis://redis:6379

# ──────────────────────────────────────────────────────────────────────────────
# SMTP (optional: invites and password resets are not mailed until set)
# ──────────────────────────────────────────────────────────────────────────────

# NOCODB_SMTP_FROM=nocodb@example.com
# NOCODB_SMTP_HOST=smtp.example.com
# NOCODB_SMTP_PORT=587
# NOCODB_SMTP_USERNAME=nocodb@example.com
# NOCODB_SMTP_PASSWORD=change_me
# NOCODB_SMTP_SECURE=false

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# NOCODB_BACKUP_INIT_SLEEP=30m
# NOCODB_BACKUP_INTERVAL=24h
# NOCODB_POSTGRES_BACKUP_PRUNE_DAYS=7
# NOCODB_DATA_BACKUP_PRUNE_DAYS=7
# NOCODB_POSTGRES_BACKUPS_PATH=/srv/nocodb-postgres/backups
# NOCODB_DATA_BACKUPS_PATH=/srv/nocodb-application-data/backups
# NOCODB_POSTGRES_BACKUP_NAME=nocodb-postgres-backup
# NOCODB_DATA_BACKUP_NAME=nocodb-application-data-backup

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# NOCODB_POSTGRES_MEMORY_LIMIT=1g
# NOCODB_POSTGRES_CPU_LIMIT=1.0
# NOCODB_POSTGRES_MEMORY_RESERVATION=128m
# NOCODB_POSTGRES_CPU_RESERVATION=0.25
# NOCODB_REDIS_MEMORY_LIMIT=256m
# NOCODB_REDIS_CPU_LIMIT=0.5
# NOCODB_REDIS_MEMORY_RESERVATION=32m
# NOCODB_REDIS_CPU_RESERVATION=0.1
# NOCODB_MEMORY_LIMIT=2g
# NOCODB_CPU_LIMIT=1.0
# NOCODB_MEMORY_RESERVATION=512m
# NOCODB_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# NOCODB_BACKUPS_MEMORY_LIMIT=256m
# NOCODB_BACKUPS_CPU_LIMIT=0.5
# NOCODB_BACKUPS_MEMORY_RESERVATION=32m
# NOCODB_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits for PostgreSQL and Redis to shut down before it sends
# SIGKILL. Docker's own ten seconds can cut short a checkpoint or a save.
# NOCODB_POSTGRES_STOP_GRACE_PERIOD=60s
# NOCODB_REDIS_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# NOCODB_POSTGRES_IMAGE_VERSION=17
# NOCODB_REDIS_IMAGE_VERSION=7.4
# NOCODB_IMAGE_VERSION=2026.10.0
